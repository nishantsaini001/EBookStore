@model OrderDetailModelDTO

<div class="modal fade" id="modal-@Model.DivId" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Order Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped">
                    <tr>
                        <th>Book</th>
                        <th>Genre</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>TotalPrice</th>
                    </tr>
                    @foreach (var item in Model.OrderDetail)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (string.IsNullOrEmpty(item.Book.Image))
                                    {
                                        <img width="60"
                                             height="80"
                                             class="rounded me-3" style="width:100%;height:240px" src="~/Images/NoImage.png" class="card-img-top" alt="...">

                                    }
                                    else
                                    {
                                        <img width="30"
                                             height="80"
                                             class="rounded me-3" style="width:100%;height:260px" src="~/Images/@item.Book.Image" class="card-img-top" alt="...">

                                    }
                                   

                                    <div>
                                        <strong>@item.Book.BookName</strong><br />
                                        <small class="text-muted">@item.Book.AuthorName</small>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Book.Genre.GenreName</td>
                            <td>₹@item.Book.Price</td>
                            <td>@item.Quantity</td>
                            <td>₹@(item.Quantity * item.Book.Price)</td>
                        </tr>
                    }
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

            </div>
        </div>
    </div>
</div>
